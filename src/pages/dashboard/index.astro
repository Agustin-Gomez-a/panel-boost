---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getSessionFromCookies } from '../../lib/auth';
import sql from '../../lib/db';

const session = await getSessionFromCookies(Astro.cookies);
if (!session) return Astro.redirect('/login');

// Fetch user orders
let orders: any[] = [];
let orderStats = { total: 0, pending: 0, completed: 0, inProgress: 0 };

try {
  orders = await sql`
    SELECT id, smm_order_id, service_name, category, link, quantity, charge, status, created_at
    FROM orders
    WHERE user_id = ${session.userId}
    ORDER BY created_at DESC
    LIMIT 10
  `;

  const stats = await sql`
    SELECT
      COUNT(*) as total,
      COUNT(CASE WHEN status = 'Pending' THEN 1 END) as pending,
      COUNT(CASE WHEN status = 'Completed' THEN 1 END) as completed,
      COUNT(CASE WHEN status = 'In progress' OR status = 'Processing' THEN 1 END) as in_progress
    FROM orders
    WHERE user_id = ${session.userId}
  `;

  if (stats.length > 0) {
    orderStats = {
      total: parseInt(stats[0].total) || 0,
      pending: parseInt(stats[0].pending) || 0,
      completed: parseInt(stats[0].completed) || 0,
      inProgress: parseInt(stats[0].in_progress) || 0,
    };
  }
} catch (e) {
  console.error('Dashboard DB error:', e);
}

function getStatusBadge(status: string) {
  const map: Record<string, string> = {
    'Completed': 'badge--success',
    'In progress': 'badge--cyan',
    'Pending': 'badge--warning',
    'Partial': 'badge--accent',
    'Canceled': 'badge--danger',
    'Processing': 'badge--cyan',
  };
  return map[status] || 'badge--warning';
}

function formatDate(date: Date | string) {
  return new Date(date).toLocaleDateString('es-AR', {
    day: '2-digit',
    month: '2-digit',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  });
}
---

<DashboardLayout title="Dashboard" activeNav="dashboard">
  <!-- Header -->
  <div class="dashboard-header">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;">
      <div>
        <h1 style="font-size:1.75rem;margin-bottom:0.25rem;">
          Hola, <span class="gradient-text">{session.name.split(' ')[0]}</span> 👋
        </h1>
        <p style="color:var(--text-secondary);font-size:0.875rem;">
          Bienvenido a tu panel de control
        </p>
      </div>
      <a href="/dashboard/new-order" class="btn btn--primary" id="dashboard-new-order-btn">
        <i class="fa-solid fa-circle-plus"></i>
        Nuevo Pedido
      </a>
    </div>
  </div>

  <!-- Stats Grid -->
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-card__icon stat-card__icon--accent">
        <i class="fa-solid fa-list-check" aria-hidden="true"></i>
      </div>
      <div>
        <div class="stat-card__value">{orderStats.total}</div>
        <div class="stat-card__label">Total Pedidos</div>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-card__icon stat-card__icon--cyan">
        <i class="fa-solid fa-spinner" aria-hidden="true"></i>
      </div>
      <div>
        <div class="stat-card__value">{orderStats.inProgress}</div>
        <div class="stat-card__label">En Progreso</div>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-card__icon stat-card__icon--success">
        <i class="fa-solid fa-check-circle" aria-hidden="true"></i>
      </div>
      <div>
        <div class="stat-card__value">{orderStats.completed}</div>
        <div class="stat-card__label">Completados</div>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-card__icon stat-card__icon--warning">
        <i class="fa-solid fa-dollar-sign" aria-hidden="true"></i>
      </div>
      <div>
        <div class="stat-card__value" id="balance-value">
          <span class="spinner" style="width:16px;height:16px;border-width:2px;"></span>
        </div>
        <div class="stat-card__label">Balance USD</div>
      </div>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="quick-actions-grid" style="display:grid;gap:1rem;margin-bottom:2rem;">
    <a href="/dashboard/new-order" class="card" style="text-decoration:none;text-align:center;cursor:pointer;" id="quick-new-order">
      <i class="fa-solid fa-rocket" style="font-size:1.75rem;color:var(--accent-light);margin-bottom:0.75rem;display:block;" aria-hidden="true"></i>
      <div style="font-weight:600;font-size:0.9rem;color:var(--text-primary);">Nuevo Pedido</div>
      <div style="font-size:0.75rem;color:var(--text-muted);margin-top:0.25rem;">Crear pedido de servicios</div>
    </a>

    <a href="/dashboard/orders" class="card" style="text-decoration:none;text-align:center;cursor:pointer;" id="quick-view-orders">
      <i class="fa-solid fa-eye" style="font-size:1.75rem;color:var(--cyan);margin-bottom:0.75rem;display:block;" aria-hidden="true"></i>
      <div style="font-weight:600;font-size:0.9rem;color:var(--text-primary);">Ver Pedidos</div>
      <div style="font-size:0.75rem;color:var(--text-muted);margin-top:0.25rem;">Historial completo</div>
    </a>

    <a href="/dashboard/services" class="card" style="text-decoration:none;text-align:center;cursor:pointer;" id="quick-services">
      <i class="fa-solid fa-layer-group" style="font-size:1.75rem;color:var(--success);margin-bottom:0.75rem;display:block;" aria-hidden="true"></i>
      <div style="font-weight:600;font-size:0.9rem;color:var(--text-primary);">Servicios</div>
      <div style="font-size:0.75rem;color:var(--text-muted);margin-top:0.25rem;">Explorar catálogo</div>
    </a>
  </div>

  <!-- Recent Orders -->
  <div>
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;flex-wrap:wrap;gap:0.5rem;">
      <h2 style="font-size:1.15rem;">Pedidos Recientes</h2>
      <a href="/dashboard/orders" class="btn btn--ghost btn--sm" id="view-all-orders-btn">
        Ver todos <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
      </a>
    </div>

    {orders.length === 0 ? (
      <div class="card" style="text-align:center;padding:3rem;">
        <i class="fa-solid fa-inbox" style="font-size:3rem;color:var(--text-muted);margin-bottom:1rem;display:block;" aria-hidden="true"></i>
        <h3 style="color:var(--text-secondary);margin-bottom:0.5rem;">Sin pedidos aún</h3>
        <p style="color:var(--text-muted);font-size:0.875rem;margin-bottom:1.5rem;">
          ¡Creá tu primer pedido y empezá a crecer!
        </p>
        <a href="/dashboard/new-order" class="btn btn--primary" id="first-order-btn">
          <i class="fa-solid fa-plus" aria-hidden="true"></i>
          Crear primer pedido
        </a>
      </div>
    ) : (
      <div class="table-wrapper" role="region" aria-label="Pedidos recientes">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col">ID</th>
              <th scope="col">Servicio</th>
              <th scope="col">Link</th>
              <th scope="col">Cantidad</th>
              <th scope="col">Cargo</th>
              <th scope="col">Estado</th>
              <th scope="col">Fecha</th>
            </tr>
          </thead>
          <tbody>
            {orders.map((order) => (
              <tr>
                <td>
                  <span class="font-mono" style="font-family:var(--font-mono);font-size:0.8rem;color:var(--text-muted);">
                    #{order.smm_order_id || '—'}
                  </span>
                </td>
                <td>
                  <div style="max-width:200px;">
                    <div style="font-size:0.8rem;font-weight:600;color:var(--text-primary);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                      {order.service_name || 'Servicio'}
                    </div>
                    {order.category && (
                      <div style="font-size:0.7rem;color:var(--text-muted);">{order.category}</div>
                    )}
                  </div>
                </td>
                <td>
                  <a
                    href={order.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    style="font-size:0.8rem;color:var(--accent-light);max-width:150px;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;text-decoration:none;"
                    title={order.link}
                  >
                    {order.link}
                  </a>
                </td>
                <td style="font-size:0.875rem;">{order.quantity.toLocaleString('es-AR')}</td>
                <td style="font-size:0.875rem;font-weight:600;color:var(--success);">
                  ${parseFloat(order.charge || 0).toFixed(4)}
                </td>
                <td>
                  <span class={`badge ${getStatusBadge(order.status)}`}>
                    {order.status}
                  </span>
                </td>
                <td style="font-size:0.75rem;color:var(--text-muted);white-space:nowrap;">
                  {formatDate(order.created_at)}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>
</DashboardLayout>

<script>
  // Fetch balance
  async function loadBalance() {
    const el = document.getElementById('balance-value');
    if (!el) return;

    try {
      const res = await fetch('/api/smm/balance');
      const data = await res.json();
      if (data.balance) {
        el.textContent = `$${parseFloat(data.balance.balance).toFixed(2)}`;
      } else {
        el.textContent = 'N/A';
      }
    } catch {
      if (el) el.textContent = '—';
    }
  }

  document.addEventListener('DOMContentLoaded', loadBalance);
</script>
