---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getSessionFromCookies } from '../../lib/auth';
import sql from '../../lib/db';

const session = await getSessionFromCookies(Astro.cookies);
if (!session) return Astro.redirect('/login');

let successMsg = '';
let errorMsg = '';

// Ensure tickets table exists
try {
  await sql`
    CREATE TABLE IF NOT EXISTS tickets (
      id SERIAL PRIMARY KEY,
      user_id INTEGER REFERENCES users(id),
      subject VARCHAR(255) NOT NULL,
      category VARCHAR(50) NOT NULL,
      status VARCHAR(50) DEFAULT 'open',
      priority VARCHAR(50) DEFAULT 'normal',
      created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
    )
  `;

  await sql`
    CREATE TABLE IF NOT EXISTS ticket_messages (
      id SERIAL PRIMARY KEY,
      ticket_id INTEGER REFERENCES tickets(id) ON DELETE CASCADE,
      user_id INTEGER REFERENCES users(id),
      message TEXT NOT NULL,
      is_staff BOOLEAN DEFAULT FALSE,
      created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
    )
  `;

  if (Astro.request.method === 'POST') {
    const formData = await Astro.request.formData();
    const subject = formData.get('subject')?.toString().trim();
    const category = formData.get('category')?.toString();
    const message = formData.get('message')?.toString().trim();

    if (subject && category && message) {
      const [ticket] = await sql`
        INSERT INTO tickets (user_id, subject, category)
        VALUES (${session.userId}, ${subject}, ${category})
        RETURNING id
      `;

      await sql`
        INSERT INTO ticket_messages (ticket_id, user_id, message, is_staff)
        VALUES (${ticket.id}, ${session.userId}, ${message}, FALSE)
      `;

      successMsg = `Ticket #${ticket.id} creado con éxito. Te responderemos a la brevedad.`;
    } else {
      errorMsg = 'Completá todos los campos requeridos.';
    }
  }
} catch (e) {
  console.error('Tickets error:', e);
}

let userTickets: any[] = [];
try {
  userTickets = await sql`
    SELECT t.id, t.subject, t.category, t.status, t.created_at,
           COUNT(m.id) as message_count
    FROM tickets t
    LEFT JOIN ticket_messages m ON m.ticket_id = t.id
    WHERE t.user_id = ${session.userId}
    GROUP BY t.id
    ORDER BY t.created_at DESC
  `;
} catch (e) {}
---

<DashboardLayout title="Soporte y Tickets" activeNav="tickets">
  <div class="dashboard-header">
    <h1 style="font-size:1.75rem;margin-bottom:0.25rem;">
      <span class="gradient-text">Tickets</span> de Soporte
    </h1>
    <p style="color:var(--text-secondary);font-size:0.875rem;">
      ¿Tenés alguna consulta o problema con un pedido? Nuestro equipo te responde 24/7.
    </p>
  </div>

  {successMsg && (
    <div style="background:rgba(16,185,129,0.15);border:1px solid var(--success);color:var(--success);padding:1rem;border-radius:var(--radius-md);margin-bottom:1.5rem;font-size:0.9rem;font-weight:500;">
      <i class="fa-solid fa-circle-check" style="margin-right:0.5rem;"></i> {successMsg}
    </div>
  )}

  {errorMsg && (
    <div style="background:rgba(239,68,68,0.15);border:1px solid var(--danger);color:var(--danger);padding:1rem;border-radius:var(--radius-md);margin-bottom:1.5rem;font-size:0.9rem;font-weight:500;">
      <i class="fa-solid fa-triangle-exclamation" style="margin-right:0.5rem;"></i> {errorMsg}
    </div>
  )}

  <div style="display:grid;grid-template-columns:1fr 380px;gap:1.5rem;align-items:start;" id="tickets-layout">
    <!-- List of tickets -->
    <div class="card" style="padding:0;">
      <div style="padding:1.25rem 1.5rem;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;">
        <h3 style="font-size:1.05rem;margin:0;color:var(--text-primary);">Tus Tickets</h3>
        <span class="badge badge--cyan" style="font-size:0.75rem;">{userTickets.length} tickets</span>
      </div>

      <div class="table-wrapper" style="overflow-x:auto;">
        <table class="data-table" style="width:100%;table-layout:fixed;">
          <thead>
            <tr>
              <th style="width:70px;">ID</th>
              <th>Asunto</th>
              <th style="width:110px;">Departamento</th>
              <th style="width:100px;">Estado</th>
              <th style="width:120px;">Fecha</th>
            </tr>
          </thead>
          <tbody>
            {userTickets.map((t) => (
              <tr>
                <td style="font-family:var(--font-mono);font-size:0.8rem;color:var(--text-muted);">#{t.id}</td>
                <td>
                  <div style="font-weight:600;color:var(--text-primary);font-size:0.875rem;">{t.subject}</div>
                  <div style="font-size:0.75rem;color:var(--text-muted);">{t.message_count} mensaje(s)</div>
                </td>
                <td>
                  <span class="badge badge--accent" style="font-size:0.65rem;text-transform:capitalize;">{t.category}</span>
                </td>
                <td>
                  <span class={`badge ${t.status === 'open' ? 'badge--success' : 'badge--cyan'}`} style="font-size:0.65rem;text-transform:uppercase;">
                    {t.status === 'open' ? 'Abierto' : t.status}
                  </span>
                </td>
                <td style="font-size:0.8rem;color:var(--text-secondary);">
                  {new Date(t.created_at).toLocaleDateString('es-AR')}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        {userTickets.length === 0 && (
          <div style="text-align:center;padding:3rem;color:var(--text-muted);font-size:0.9rem;">
            <i class="fa-solid fa-ticket" style="font-size:2rem;margin-bottom:0.75rem;opacity:0.4;display:block;"></i>
            No tenés tickets creados todavía.
          </div>
        )}
      </div>
    </div>

    <!-- Create Ticket Form -->
    <div class="card" style="padding:1.5rem;">
      <h3 style="font-size:1.1rem;margin-bottom:1.25rem;display:flex;align-items:center;gap:0.5rem;">
        <i class="fa-solid fa-plus-circle" style="color:var(--accent);"></i>
        Crear Nuevo Ticket
      </h3>

      <form method="POST" style="display:flex;flex-direction:column;gap:1rem;">
        <div class="form-group">
          <label class="form-label">Departamento</label>
          <select name="category" class="form-input" required>
            <option value="pedidos">Problemas con un Pedido</option>
            <option value="pagos">Pagos / Saldo</option>
            <option value="api">Soporte de API</option>
            <option value="otro">Otro tipo de consulta</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label">Asunto / ID de Pedido</label>
          <input type="text" name="subject" class="form-input" placeholder="Ej: Pedido #1234 demora" required />
        </div>

        <div class="form-group">
          <label class="form-label">Mensaje</label>
          <textarea name="message" class="form-input" rows="4" placeholder="Describí tu consulta detalladamente..." style="resize:vertical;min-height:100px;" required></textarea>
        </div>

        <button type="submit" class="btn btn--primary" style="width:100%;justify-content:center;margin-top:0.5rem;">
          <i class="fa-solid fa-paper-plane" style="margin-right:0.5rem;"></i>
          Enviar Ticket
        </button>
      </form>
    </div>
  </div>
</DashboardLayout>

<style>
  @media (max-width: 900px) {
    #tickets-layout {
      grid-template-columns: 1fr !important;
    }
  }
</style>
