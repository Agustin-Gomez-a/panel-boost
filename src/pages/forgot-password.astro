---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Recuperar Contraseña — Pulse Panel Boost"
  description="Recuperá el acceso a tu cuenta de Pulse Panel Boost."
  noIndex={true}
>
  <div style="min-height:100vh;display:flex;flex-direction:column;">
    <!-- Minimal navbar -->
    <header class="navbar">
      <div class="container">
        <div class="navbar__inner">
          <a href="/" class="navbar__logo" aria-label="Pulse Panel Boost - Inicio">
            <div class="navbar__logo-icon">
              <i class="fa-solid fa-bolt"></i>
            </div>
            <span class="navbar__logo-text">Pulse<span>Boost</span></span>
          </a>
          <div class="navbar__actions" style="margin-left:auto;">
            <button class="theme-toggle" onclick="toggleTheme()" aria-label="Cambiar tema" id="theme-toggle-fp">
              <i id="theme-icon" class="fa-solid fa-sun"></i>
            </button>
          </div>
        </div>
      </div>
    </header>

    <!-- Main -->
    <main style="flex:1;display:flex;align-items:center;justify-content:center;padding:2rem;" aria-labelledby="fp-title">
      <div style="width:100%;max-width:420px;">

        <!-- Success state (hidden by default) -->
        <div id="success-state" style="display:none;text-align:center;" class="animate-fade-up">
          <div style="width:80px;height:80px;border-radius:var(--radius-xl);background:rgba(16,185,129,0.15);border:1px solid var(--success);display:flex;align-items:center;justify-content:center;font-size:2rem;margin:0 auto 1.5rem;color:var(--success);">
            <i class="fa-solid fa-envelope-circle-check"></i>
          </div>
          <h1 style="font-size:1.75rem;margin-bottom:0.75rem;">¡Revisá tu email!</h1>
          <p style="color:var(--text-secondary);font-size:0.95rem;line-height:1.7;margin-bottom:2rem;">
            Si el email está registrado, recibirás un enlace para restablecer tu contraseña en los próximos minutos.<br>
            <strong style="color:var(--text-primary);">Revisá también la carpeta de spam.</strong>
          </p>
          <a href="/login" class="btn btn--primary btn--lg" style="width:100%;justify-content:center;">
            <i class="fa-solid fa-arrow-right-to-bracket"></i>
            Volver al login
          </a>
        </div>

        <!-- Form state -->
        <div id="form-state">
          <!-- Header -->
          <div style="text-align:center;margin-bottom:2rem;" class="animate-fade-up">
            <div style="width:64px;height:64px;border-radius:var(--radius-lg);background:linear-gradient(135deg,rgba(124,58,237,0.2),rgba(6,182,212,0.2));border:1px solid var(--accent);display:flex;align-items:center;justify-content:center;font-size:1.75rem;color:var(--accent-light);margin:0 auto 1.25rem;" aria-hidden="true">
              <i class="fa-solid fa-key"></i>
            </div>
            <h1 id="fp-title" style="font-size:1.75rem;margin-bottom:0.5rem;">¿Olvidaste tu contraseña?</h1>
            <p style="color:var(--text-secondary);font-size:0.9rem;line-height:1.6;">
              Ingresá tu email y te enviaremos un enlace para recuperar el acceso.
            </p>
          </div>

          <!-- Card -->
          <div class="card card--glow animate-fade-up animate-fade-up-delay-1">
            <form id="fp-form" novalidate>
              <div style="display:flex;flex-direction:column;gap:1.25rem;">
                <div class="form-group">
                  <label class="form-label" for="fp-email">Email</label>
                  <div class="form-input-wrapper">
                    <i class="fa-solid fa-envelope form-input-icon" aria-hidden="true"></i>
                    <input
                      class="form-input"
                      type="email"
                      id="fp-email"
                      name="email"
                      placeholder="vos@ejemplo.com"
                      autocomplete="email"
                      required
                      aria-required="true"
                    />
                  </div>
                  <span class="form-error" id="fp-email-error" role="alert" style="display:none;">
                    <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
                    Ingresá un email válido
                  </span>
                </div>

                <div id="fp-error" class="alert alert--error" style="display:none;" role="alert"></div>

                <button type="submit" class="btn btn--primary" id="fp-submit" style="width:100%;justify-content:center;padding:0.875rem;">
                  <i class="fa-solid fa-paper-plane"></i>
                  Enviar enlace de recuperación
                </button>
              </div>
            </form>
          </div>

          <!-- Back to login -->
          <p style="text-align:center;margin-top:1.5rem;font-size:0.875rem;color:var(--text-secondary);" class="animate-fade-up animate-fade-up-delay-2">
            <a href="/login" style="color:var(--accent-light);font-weight:600;text-decoration:none;">
              <i class="fa-solid fa-arrow-left" style="margin-right:0.25rem;"></i>
              Volver al login
            </a>
          </p>
        </div>

      </div>
    </main>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('fp-form') as HTMLFormElement;
  const submitBtn = document.getElementById('fp-submit') as HTMLButtonElement;
  const fpError = document.getElementById('fp-error') as HTMLElement;
  const emailError = document.getElementById('fp-email-error') as HTMLElement;
  const formState = document.getElementById('form-state') as HTMLElement;
  const successState = document.getElementById('success-state') as HTMLElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const email = (document.getElementById('fp-email') as HTMLInputElement).value.trim();
    emailError.style.display = 'none';
    fpError.style.display = 'none';

    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      emailError.style.display = 'flex';
      return;
    }

    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span class="spinner"></span> Enviando...';

    try {
      const formData = new FormData();
      formData.append('email', email);

      const res = await fetch('/api/auth/forgot-password', {
        method: 'POST',
        body: formData,
      });

      const data = await res.json();

      if (res.ok && data.success) {
        formState.style.display = 'none';
        successState.style.display = 'block';
      } else {
        fpError.style.display = 'flex';
        fpError.innerHTML = `<i class="fa-solid fa-triangle-exclamation"></i> ${data.error || 'Error al enviar. Intentá de nuevo.'}`;
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> Enviar enlace de recuperación';
      }
    } catch {
      fpError.style.display = 'flex';
      fpError.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i> Error de conexión. Intentá de nuevo.';
      submitBtn.disabled = false;
      submitBtn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> Enviar enlace de recuperación';
    }
  });

  // Sync theme icon
  const themeIcon = document.getElementById('theme-icon');
  if (themeIcon) {
    const theme = document.documentElement.getAttribute('data-theme');
    themeIcon.className = theme === 'dark' ? 'fa-solid fa-sun' : 'fa-solid fa-moon';
  }
</script>
