---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSessionFromCookies } from '../lib/auth';

const session = await getSessionFromCookies(Astro.cookies);
---

<BaseLayout
  title="Pulse Panel Boost — Impulsa tus Redes Sociales"
  description="El panel SMM profesional para crecer en Instagram, TikTok, YouTube y más. Seguidores reales, entrega rápida y precios competitivos. ¡Empezá hoy!"
>
  <!-- ===== NAVBAR ===== -->
  <header class="navbar">
    <div class="container">
      <div class="navbar__inner">
        <a href="/" class="navbar__logo" aria-label="Pulse Panel Boost - Inicio">
          <img src="/img/logo1.png" alt="Pulse Panel Boost Logo" class="logo-dark" style="height: 56px; width: auto;" />
          <img src="/img/logo2light.png" alt="Pulse Panel Boost Logo" class="logo-light" style="height: 56px; width: auto; display:none;" />
        </a>

        <ul class="navbar__nav" id="navbar-nav" role="navigation" aria-label="Navegación principal">
          <li><a href="#features">Características</a></li>
          <li><a href="#networks">Redes</a></li>
          <li><a href="#process">Cómo Funciona</a></li>
          <li><a href="#pricing">Precios</a></li>
          <li><a href="#faq">FAQ</a></li>
        </ul>

        <div class="navbar__actions">
          <button
            id="theme-toggle-btn"
            class="theme-toggle"
            onclick="toggleTheme()"
            aria-label="Cambiar tema"
            title="Cambiar tema claro/oscuro"
          >
            <i id="theme-icon" class="fa-solid fa-sun"></i>
          </button>

          {session ? (
            <a href="/dashboard" class="btn btn--primary btn--sm" id="nav-dashboard-btn" style="gap:0.5rem;display:flex;align-items:center;">
              <i class="fa-solid fa-user"></i>
              <span style="display:none;" class="desktop-only">Panel de {session.name.split(' ')[0]}</span>
              <span class="mobile-only">Panel</span>
            </a>
          ) : (
            <>
              <a href="/login" class="btn btn--ghost btn--sm" id="nav-login-btn">
                <i class="fa-solid fa-arrow-right-to-bracket"></i>
                Login
              </a>
              <a href="/register" class="btn btn--primary btn--sm" id="nav-register-btn">
                Registrate Gratis
              </a>
            </>
          )}

          <button
            class="mobile-menu-btn"
            onclick="toggleMobileMenu()"
            aria-label="Menú"
            aria-expanded="false"
          >
            <i class="fa-solid fa-bars"></i>
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- ===== HERO ===== -->
  <section class="hero" id="hero" aria-labelledby="hero-title" style="min-height: 100vh; display: flex; align-items: center; position: relative; margin-top: -80px; padding-top: 80px;">
    <!-- Hero background images per theme -->
    <div class="hero-bg hero-bg--dark" style="position:absolute; inset:0; background: url('/img/hero2.png') center right / cover no-repeat; z-index: 0;"></div>
    <div class="hero-bg hero-bg--light" style="position:absolute; inset:0; background: url('/img/hero3.png') center right / cover no-repeat; z-index: 0; display:none;"></div>
    <!-- Dark overlay -->
    <div class="hero-overlay" style="position:absolute; inset:0; z-index: 0;"></div>
    
    <!-- Particles -->
    <div class="particles-container" aria-hidden="true" id="particles-container" style="z-index: 1;"></div>

    <div class="container" style="position: relative; z-index: 2; width: 100%;">
      <div class="hero__layout" style="display: block;">
        <!-- Left: Content -->
        <div class="hero__content" style="max-width: 600px;">
          <div class="hero__tag animate-fade-up">
            <span class="section-tag">
              <i class="fa-solid fa-rocket"></i>
              Plataforma SMM #1 en Latam
            </span>
          </div>

          <h1 class="hero__title animate-fade-up animate-fade-up-delay-1" id="hero-title">
            Hacé crecer tus<br />
            <span class="gradient-text">redes sociales</span><br />
            al siguiente nivel
          </h1>

          <p class="hero__subtitle animate-fade-up animate-fade-up-delay-2">
            Impulsa tu presencia digital con servicios premium de seguidores, likes y
            engagement. Entrega rápida, precios competitivos y soporte 24/7.
          </p>

          <div class="hero__actions animate-fade-up animate-fade-up-delay-3">
            <a href="/register" class="btn btn--primary btn--lg" id="hero-cta-primary">
              <i class="fa-solid fa-rocket"></i>
              Empezá Gratis Ahora
            </a>
          </div>

          <div class="hero__badges animate-fade-up animate-fade-up-delay-4">
            <span class="hero__badge">
              <i class="fa-solid fa-circle-check"></i>
              Entrega garantizada
            </span>
            <span class="hero__badge">
              <i class="fa-solid fa-circle-check"></i>
              Sin contraseña requerida
            </span>
            <span class="hero__badge">
              <i class="fa-solid fa-circle-check"></i>
              Pago seguro
            </span>
            <span class="hero__badge">
              <i class="fa-solid fa-circle-check"></i>
              Soporte 24/7
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== REDES SOCIALES ===== -->
  <section id="networks" aria-labelledby="networks-title" style="position: relative; overflow: hidden; padding: 5rem 0;">
    <div class="section-bg section-bg--networks-dark" style="position:absolute; inset:0; background: url('/img/Todas%20tus%20redes-dark.png') center / cover no-repeat; z-index: 0;"></div>
    <div class="section-bg section-bg--networks-light" style="position:absolute; inset:0; background: url('/img/Todas%20tus%20redes-light.png') center / cover no-repeat; z-index: 0; display:none;"></div>
    <div class="container" style="position: relative; z-index: 1;">
      <div class="section-header">
        <div class="section-tag">
          <i class="fa-solid fa-share-nodes"></i>
          Plataformas soportadas
        </div>
        <h2 id="networks-title">Todas tus redes, <span class="gradient-text">un solo panel</span></h2>
        <p>Gestioná el crecimiento de todas tus plataformas desde un único lugar. Rápido, simple y efectivo.</p>
      </div>

      <div class="network-grid" role="list" aria-label="Redes sociales soportadas">
        <div class="network-icon network-icon--instagram" role="listitem">
          <div class="network-icon__circle">
            <i class="fa-brands fa-instagram" aria-hidden="true"></i>
          </div>
          <span>Instagram</span>
        </div>
        <div class="network-icon network-icon--tiktok" role="listitem">
          <div class="network-icon__circle">
            <i class="fa-brands fa-tiktok" aria-hidden="true"></i>
          </div>
          <span>TikTok</span>
        </div>
        <div class="network-icon network-icon--youtube" role="listitem">
          <div class="network-icon__circle">
            <i class="fa-brands fa-youtube" aria-hidden="true"></i>
          </div>
          <span>YouTube</span>
        </div>
        <div class="network-icon network-icon--twitter" role="listitem">
          <div class="network-icon__circle">
            <i class="fa-brands fa-x-twitter" aria-hidden="true"></i>
          </div>
          <span>X / Twitter</span>
        </div>
        <div class="network-icon network-icon--facebook" role="listitem">
          <div class="network-icon__circle">
            <i class="fa-brands fa-facebook-f" aria-hidden="true"></i>
          </div>
          <span>Facebook</span>
        </div>
        <div class="network-icon network-icon--spotify" role="listitem">
          <div class="network-icon__circle">
            <i class="fa-brands fa-spotify" aria-hidden="true"></i>
          </div>
          <span>Spotify</span>
        </div>
        <div class="network-icon network-icon--twitch" role="listitem">
          <div class="network-icon__circle">
            <i class="fa-brands fa-twitch" aria-hidden="true"></i>
          </div>
          <span>Twitch</span>
        </div>
        <div class="network-icon network-icon--telegram" role="listitem">
          <div class="network-icon__circle">
            <i class="fa-brands fa-telegram" aria-hidden="true"></i>
          </div>
          <span>Telegram</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== FEATURES ===== -->
  <section id="features" aria-labelledby="features-title" style="position: relative; overflow: hidden; padding: 5rem 0;">
    <div class="section-bg section-bg--features-dark" style="position:absolute; inset:0; background: url('/img/caractdark.png') center / cover no-repeat; z-index: 0;"></div>
    <div class="section-bg section-bg--features-light" style="position:absolute; inset:0; background: url('/img/caractlight.png') center / cover no-repeat; z-index: 0; display:none;"></div>
    <div class="container" style="position: relative; z-index: 1;">
      <div class="section-header">
        <div class="section-tag">
          <i class="fa-solid fa-star"></i>
          Por qué elegirnos
        </div>
        <h2 id="features-title">Características <span class="gradient-text">que importan</span></h2>
        <p>No somos un panel más. Somos tu herramienta de crecimiento digital definitiva.</p>
      </div>

      <div class="features-grid">
        <article class="feature-card" aria-label="Entrega Ultra Rápida">
          <div class="feature-card__icon feature-card__icon--accent">
            <i class="fa-solid fa-bolt" aria-hidden="true"></i>
          </div>
          <h3>Entrega Ultra Rápida</h3>
          <p>Los pedidos comienzan a procesarse en minutos. Sin esperas innecesarias. Tu crecimiento no puede esperar.</p>
        </article>

        <article class="feature-card" aria-label="100% Seguro">
          <div class="feature-card__icon feature-card__icon--cyan">
            <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
          </div>
          <h3>100% Seguro</h3>
          <p>No pedimos tu contraseña. Solo necesitamos el enlace público. Tu cuenta siempre está protegida.</p>
        </article>

        <article class="feature-card" aria-label="Precios Competitivos">
          <div class="feature-card__icon feature-card__icon--success">
            <i class="fa-solid fa-dollar-sign" aria-hidden="true"></i>
          </div>
          <h3>Precios Competitivos</h3>
          <p>Los mejores precios del mercado con calidad premium. Más por menos. Planes para todos los presupuestos.</p>
        </article>

        <article class="feature-card" aria-label="Soporte 24/7">
          <div class="feature-card__icon feature-card__icon--warning">
            <i class="fa-solid fa-headset" aria-hidden="true"></i>
          </div>
          <h3>Soporte 24/7</h3>
          <p>Nuestro equipo está disponible todo el día, todos los días. Cualquier problema, lo resolvemos al instante.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ===== PROCESS ===== -->
  <section id="process" aria-labelledby="process-title">
    <div class="container">
      <div class="section-header">
        <div class="section-tag">
          <i class="fa-solid fa-route"></i>
          Proceso simple
        </div>
        <h2 id="process-title">Empezá a crecer en <span class="gradient-text">4 pasos</span></h2>
        <p>Sin complicaciones. En menos de 5 minutos ya podés tener tu primer pedido activo.</p>
      </div>

      <div class="steps-grid">
        <div class="step-card">
          <div class="step-number" aria-hidden="true">1</div>
          <h3 style="font-size:1rem;margin-bottom:0.5rem;">Creá tu cuenta</h3>
          <p style="font-size:0.875rem;color:var(--text-secondary);line-height:1.6;">
            Registrate gratis en menos de 1 minuto. Solo necesitás tu email y una contraseña.
          </p>
        </div>

        <div class="step-card">
          <div class="step-number" aria-hidden="true">2</div>
          <h3 style="font-size:1rem;margin-bottom:0.5rem;">Elegí un servicio</h3>
          <p style="font-size:0.875rem;color:var(--text-secondary);line-height:1.6;">
            Explorá cientos de servicios para todas las redes. Filtrá por plataforma y categoría.
          </p>
        </div>

        <div class="step-card">
          <div class="step-number" aria-hidden="true">3</div>
          <h3 style="font-size:1rem;margin-bottom:0.5rem;">Colocá tu pedido</h3>
          <p style="font-size:0.875rem;color:var(--text-secondary);line-height:1.6;">
            Ingresá el link de tu perfil o publicación y la cantidad que necesitás.
          </p>
        </div>

        <div class="step-card">
          <div class="step-number" aria-hidden="true">4</div>
          <h3 style="font-size:1rem;margin-bottom:0.5rem;">¡Listo, crecé!</h3>
          <p style="font-size:0.875rem;color:var(--text-secondary);line-height:1.6;">
            Recibí tu pedido rápidamente. Monitoreá el progreso desde tu dashboard en tiempo real.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== PRICING ===== -->
  <section id="pricing" aria-labelledby="pricing-title">
    <div class="container">
      <div class="section-header">
        <div class="section-tag">
          <i class="fa-solid fa-tag"></i>
          Servicios y Precios
        </div>
        <h2 id="pricing-title">Precios <span class="gradient-text">transparentes</span></h2>
        <p>Sin costos ocultos. Elegí la cantidad que necesitás y pagá solo por lo que usás.</p>
      </div>

      <div class="pricing-tabs" id="pricing-tabs" role="tablist" aria-label="Categorías de servicios">
        <button class="pricing-tab active" role="tab" aria-selected="true" data-tab="instagram" id="tab-instagram">
          <i class="fa-brands fa-instagram"></i> Instagram
        </button>
        <button class="pricing-tab" role="tab" aria-selected="false" data-tab="tiktok" id="tab-tiktok">
          <i class="fa-brands fa-tiktok"></i> TikTok
        </button>
        <button class="pricing-tab" role="tab" aria-selected="false" data-tab="youtube" id="tab-youtube">
          <i class="fa-brands fa-youtube"></i> YouTube
        </button>
        <button class="pricing-tab" role="tab" aria-selected="false" data-tab="facebook" id="tab-facebook">
          <i class="fa-brands fa-facebook-f"></i> Facebook
        </button>
      </div>

      <!-- Instagram -->
      <div class="pricing-panel active" id="panel-instagram" role="tabpanel" aria-labelledby="tab-instagram">
        <div class="pricing-grid">
          <div class="pricing-card">
            <div class="pricing-card__header">
              <div class="pricing-card__platform">
                <i class="fa-brands fa-instagram" style="color:#E1306C;"></i>
                <span>Instagram</span>
              </div>
              <h3>Seguidores</h3>
              <p>Seguidores reales de alta calidad para tu perfil</p>
            </div>
            <div class="pricing-card__table">
              <div class="pricing-row">
                <span>100 seguidores</span>
                <span class="pricing-row__price">$0.99</span>
              </div>
              <div class="pricing-row">
                <span>500 seguidores</span>
                <span class="pricing-row__price">$3.49</span>
              </div>
              <div class="pricing-row pricing-row--popular">
                <span>1,000 seguidores <span class="badge badge--accent" style="font-size:0.6rem;padding:0.1rem 0.4rem;">Popular</span></span>
                <span class="pricing-row__price">$5.99</span>
              </div>
              <div class="pricing-row">
                <span>5,000 seguidores</span>
                <span class="pricing-row__price">$24.99</span>
              </div>
              <div class="pricing-row">
                <span>10,000 seguidores</span>
                <span class="pricing-row__price">$44.99</span>
              </div>
            </div>
            <a href="/register" class="btn btn--primary" id="ig-followers-btn" style="width:100%;justify-content:center;margin-top:1.25rem;">
              <i class="fa-solid fa-shopping-cart"></i>
              Comprar Ahora
            </a>
          </div>

          <div class="pricing-card">
            <div class="pricing-card__header">
              <div class="pricing-card__platform">
                <i class="fa-brands fa-instagram" style="color:#E1306C;"></i>
                <span>Instagram</span>
              </div>
              <h3>Likes</h3>
              <p>Aumentá el engagement de tus publicaciones</p>
            </div>
            <div class="pricing-card__table">
              <div class="pricing-row">
                <span>100 likes</span>
                <span class="pricing-row__price">$0.49</span>
              </div>
              <div class="pricing-row">
                <span>500 likes</span>
                <span class="pricing-row__price">$1.99</span>
              </div>
              <div class="pricing-row pricing-row--popular">
                <span>1,000 likes <span class="badge badge--accent" style="font-size:0.6rem;padding:0.1rem 0.4rem;">Popular</span></span>
                <span class="pricing-row__price">$3.49</span>
              </div>
              <div class="pricing-row">
                <span>5,000 likes</span>
                <span class="pricing-row__price">$14.99</span>
              </div>
              <div class="pricing-row">
                <span>10,000 likes</span>
                <span class="pricing-row__price">$26.99</span>
              </div>
            </div>
            <a href="/register" class="btn btn--primary" id="ig-likes-btn" style="width:100%;justify-content:center;margin-top:1.25rem;">
              <i class="fa-solid fa-shopping-cart"></i>
              Comprar Ahora
            </a>
          </div>

          <div class="pricing-card">
            <div class="pricing-card__header">
              <div class="pricing-card__platform">
                <i class="fa-brands fa-instagram" style="color:#E1306C;"></i>
                <span>Instagram</span>
              </div>
              <h3>Views (Reels)</h3>
              <p>Más reproducciones para tus Reels e historias</p>
            </div>
            <div class="pricing-card__table">
              <div class="pricing-row">
                <span>1,000 views</span>
                <span class="pricing-row__price">$0.29</span>
              </div>
              <div class="pricing-row">
                <span>5,000 views</span>
                <span class="pricing-row__price">$1.19</span>
              </div>
              <div class="pricing-row pricing-row--popular">
                <span>10,000 views <span class="badge badge--accent" style="font-size:0.6rem;padding:0.1rem 0.4rem;">Popular</span></span>
                <span class="pricing-row__price">$1.99</span>
              </div>
              <div class="pricing-row">
                <span>50,000 views</span>
                <span class="pricing-row__price">$7.99</span>
              </div>
              <div class="pricing-row">
                <span>100,000 views</span>
                <span class="pricing-row__price">$13.99</span>
              </div>
            </div>
            <a href="/register" class="btn btn--primary" id="ig-views-btn" style="width:100%;justify-content:center;margin-top:1.25rem;">
              <i class="fa-solid fa-shopping-cart"></i>
              Comprar Ahora
            </a>
          </div>
        </div>
      </div>

      <!-- TikTok -->
      <div class="pricing-panel" id="panel-tiktok" role="tabpanel" aria-labelledby="tab-tiktok">
        <div class="pricing-grid">
          <div class="pricing-card">
            <div class="pricing-card__header">
              <div class="pricing-card__platform">
                <i class="fa-brands fa-tiktok"></i>
                <span>TikTok</span>
              </div>
              <h3>Seguidores</h3>
              <p>Seguidores de calidad para tu cuenta TikTok</p>
            </div>
            <div class="pricing-card__table">
              <div class="pricing-row">
                <span>100 seguidores</span>
                <span class="pricing-row__price">$0.79</span>
              </div>
              <div class="pricing-row">
                <span>500 seguidores</span>
                <span class="pricing-row__price">$2.99</span>
              </div>
              <div class="pricing-row pricing-row--popular">
                <span>1,000 seguidores <span class="badge badge--accent" style="font-size:0.6rem;padding:0.1rem 0.4rem;">Popular</span></span>
                <span class="pricing-row__price">$4.99</span>
              </div>
              <div class="pricing-row">
                <span>5,000 seguidores</span>
                <span class="pricing-row__price">$19.99</span>
              </div>
              <div class="pricing-row">
                <span>10,000 seguidores</span>
                <span class="pricing-row__price">$36.99</span>
              </div>
            </div>
            <a href="/register" class="btn btn--primary" id="tt-followers-btn" style="width:100%;justify-content:center;margin-top:1.25rem;">
              <i class="fa-solid fa-shopping-cart"></i>
              Comprar Ahora
            </a>
          </div>

          <div class="pricing-card">
            <div class="pricing-card__header">
              <div class="pricing-card__platform">
                <i class="fa-brands fa-tiktok"></i>
                <span>TikTok</span>
              </div>
              <h3>Likes</h3>
              <p>Likes para tus videos y aumentá el alcance</p>
            </div>
            <div class="pricing-card__table">
              <div class="pricing-row">
                <span>100 likes</span>
                <span class="pricing-row__price">$0.39</span>
              </div>
              <div class="pricing-row">
                <span>500 likes</span>
                <span class="pricing-row__price">$1.49</span>
              </div>
              <div class="pricing-row pricing-row--popular">
                <span>1,000 likes <span class="badge badge--accent" style="font-size:0.6rem;padding:0.1rem 0.4rem;">Popular</span></span>
                <span class="pricing-row__price">$2.49</span>
              </div>
              <div class="pricing-row">
                <span>5,000 likes</span>
                <span class="pricing-row__price">$9.99</span>
              </div>
              <div class="pricing-row">
                <span>10,000 likes</span>
                <span class="pricing-row__price">$18.99</span>
              </div>
            </div>
            <a href="/register" class="btn btn--primary" id="tt-likes-btn" style="width:100%;justify-content:center;margin-top:1.25rem;">
              <i class="fa-solid fa-shopping-cart"></i>
              Comprar Ahora
            </a>
          </div>

          <div class="pricing-card">
            <div class="pricing-card__header">
              <div class="pricing-card__platform">
                <i class="fa-brands fa-tiktok"></i>
                <span>TikTok</span>
              </div>
              <h3>Views</h3>
              <p>Vistas reales para tus videos de TikTok</p>
            </div>
            <div class="pricing-card__table">
              <div class="pricing-row">
                <span>1,000 views</span>
                <span class="pricing-row__price">$0.19</span>
              </div>
              <div class="pricing-row">
                <span>5,000 views</span>
                <span class="pricing-row__price">$0.79</span>
              </div>
              <div class="pricing-row pricing-row--popular">
                <span>10,000 views <span class="badge badge--accent" style="font-size:0.6rem;padding:0.1rem 0.4rem;">Popular</span></span>
                <span class="pricing-row__price">$1.29</span>
              </div>
              <div class="pricing-row">
                <span>50,000 views</span>
                <span class="pricing-row__price">$5.49</span>
              </div>
              <div class="pricing-row">
                <span>100,000 views</span>
                <span class="pricing-row__price">$9.99</span>
              </div>
            </div>
            <a href="/register" class="btn btn--primary" id="tt-views-btn" style="width:100%;justify-content:center;margin-top:1.25rem;">
              <i class="fa-solid fa-shopping-cart"></i>
