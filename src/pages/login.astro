---
import BaseLayout from '../layouts/BaseLayout.astro';

const redirectTo = Astro.url.searchParams.get('redirect') || '/dashboard';
const error = Astro.url.searchParams.get('error');
---

<BaseLayout
  title="Iniciar Sesión — Pulse Panel Boost"
  description="Ingresá a tu cuenta de Pulse Panel Boost y gestioná tus pedidos de servicios SMM."
  noIndex={true}
>
  <div style="min-height:100vh;display:flex;flex-direction:column;">
    <!-- Minimal navbar -->
    <header class="navbar">
      <div class="container">
        <div class="navbar__inner">
          <a href="/" class="navbar__logo" aria-label="Pulse Panel Boost - Inicio">
            <div class="navbar__logo-icon">
              <i class="fa-solid fa-bolt"></i>
            </div>
            <span class="navbar__logo-text">Pulse<span>Boost</span></span>
          </a>
          <div class="navbar__actions" style="margin-left:auto;">
            <button class="theme-toggle" onclick="toggleTheme()" aria-label="Cambiar tema" id="theme-toggle-login">
              <i id="theme-icon" class="fa-solid fa-sun"></i>
            </button>
          </div>
        </div>
      </div>
    </header>

    <!-- Main -->
    <main style="flex:1;display:flex;align-items:center;justify-content:center;padding:2rem;" aria-labelledby="login-page-title">
      <div style="width:100%;max-width:440px;">
        <!-- Header -->
        <div style="text-align:center;margin-bottom:2rem;" class="animate-fade-up">
          <div style="width:64px;height:64px;border-radius:var(--radius-lg);background:var(--gradient-accent);display:flex;align-items:center;justify-content:center;font-size:1.75rem;color:white;margin:0 auto 1.25rem;box-shadow:var(--accent-glow);" aria-hidden="true">
            <i class="fa-solid fa-bolt"></i>
          </div>
          <h1 id="login-page-title" style="font-size:1.75rem;margin-bottom:0.5rem;">Bienvenido de vuelta</h1>
          <p style="color:var(--text-secondary);font-size:0.9rem;">Ingresá a tu cuenta para continuar</p>
        </div>

        <!-- Card -->
        <div class="card card--glow animate-fade-up animate-fade-up-delay-1">
          {error && (
            <div class="alert alert--error" style="margin-bottom:1.25rem;" role="alert">
              <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
              {error === 'invalid' ? 'Email o contraseña incorrectos' :
               error === 'blocked' ? 'Demasiados intentos. Intentá en 15 minutos.' :
               error === 'server' ? 'Error del servidor. Intentá de nuevo.' : error}
            </div>
          )}

          <form id="login-form" method="POST" action="/api/auth/login" novalidate>
            <input type="hidden" name="redirect" value={redirectTo} />

            <div style="display:flex;flex-direction:column;gap:1.25rem;">
              <div class="form-group">
                <label class="form-label" for="login-email">Email</label>
                <div class="form-input-wrapper">
                  <i class="fa-solid fa-envelope form-input-icon" aria-hidden="true"></i>
                  <input
                    class="form-input"
                    type="email"
                    id="login-email"
                    name="email"
                    placeholder="vos@ejemplo.com"
                    autocomplete="email"
                    required
                    aria-required="true"
                  />
                </div>
                <span class="form-error" id="email-error" role="alert" style="display:none;">
                  <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
                  Ingresá un email válido
                </span>
              </div>

              <div class="form-group">
                <label class="form-label" for="login-password">Contraseña</label>
                <div class="form-input-wrapper">
                  <i class="fa-solid fa-lock form-input-icon" aria-hidden="true"></i>
                  <input
                    class="form-input"
                    type="password"
                    id="login-password"
                    name="password"
                    placeholder="••••••••"
                    autocomplete="current-password"
                    required
                    aria-required="true"
                    style="padding-right:3rem;"
                  />
                  <button
                    type="button"
                    id="toggle-password"
                    aria-label="Mostrar u ocultar contraseña"
                    style="position:absolute;right:0.875rem;top:50%;transform:translateY(-50%);background:none;border:none;color:var(--text-muted);cursor:pointer;font-size:0.875rem;"
                  >
                    <i class="fa-solid fa-eye" id="password-eye-icon" aria-hidden="true"></i>
                  </button>
                </div>
                <span class="form-error" id="password-error" role="alert" style="display:none;">
                  <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
                  Ingresá tu contraseña
                </span>
              </div>

              <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:0.5rem;">
                <div class="checkbox-wrapper" style="cursor:pointer;" onclick="document.getElementById('remember-me').click()">
                  <input type="checkbox" name="remember" id="remember-me" onclick="event.stopPropagation()" />
                  <label for="remember-me" style="font-size:0.875rem;color:var(--text-secondary);cursor:pointer;">Recordarme</label>
                </div>
                <a href="/forgot-password" style="font-size:0.875rem;color:var(--accent-light);text-decoration:none;transition:opacity 0.15s;" onmouseover="this.style.opacity=0.8" onmouseout="this.style.opacity=1">
                  ¿Olvidaste tu contraseña?
                </a>
              </div>

              <div id="form-error" class="alert alert--error" style="display:none;" role="alert"></div>

              <button
                type="submit"
                class="btn btn--primary"
                id="login-submit-btn"
                style="width:100%;justify-content:center;padding:0.875rem;"
              >
                <i class="fa-solid fa-arrow-right-to-bracket"></i>
                Ingresar a mi cuenta
              </button>
            </div>
          </form>
        </div>

        <!-- Register link -->
        <p style="text-align:center;margin-top:1.5rem;font-size:0.875rem;color:var(--text-secondary);" class="animate-fade-up animate-fade-up-delay-2">
          ¿No tenés cuenta?
          <a href="/register" style="color:var(--accent-light);font-weight:600;text-decoration:none;">
            Registrate gratis →
          </a>
        </p>

        <!-- Back to home -->
        <p style="text-align:center;margin-top:0.75rem;">
          <a href="/" style="font-size:0.8rem;color:var(--text-muted);text-decoration:none;">
            <i class="fa-solid fa-arrow-left" style="margin-right:0.25rem;" aria-hidden="true"></i>
            Volver al inicio
          </a>
        </p>
      </div>
    </main>
  </div>
</BaseLayout>

<script>
  // Toggle password visibility
  const toggleBtn = document.getElementById('toggle-password');
  const passwordInput = document.getElementById('login-password') as HTMLInputElement;
  const eyeIcon = document.getElementById('password-eye-icon');

  toggleBtn?.addEventListener('click', () => {
    if (passwordInput.type === 'password') {
      passwordInput.type = 'text';
      if (eyeIcon) eyeIcon.className = 'fa-solid fa-eye-slash';
    } else {
      passwordInput.type = 'password';
      if (eyeIcon) eyeIcon.className = 'fa-solid fa-eye';
    }
  });

  // Client-side validation + async submit
  const form = document.getElementById('login-form') as HTMLFormElement;
  const submitBtn = document.getElementById('login-submit-btn') as HTMLButtonElement;
  const formError = document.getElementById('form-error') as HTMLElement;
  const emailError = document.getElementById('email-error') as HTMLElement;
  const passwordError = document.getElementById('password-error') as HTMLElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    let valid = true;

    const email = (document.getElementById('login-email') as HTMLInputElement).value;
    const password = (document.getElementById('login-password') as HTMLInputElement).value;

    emailError.style.display = 'none';
    passwordError.style.display = 'none';
    formError.style.display = 'none';

    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      emailError.style.display = 'flex';
      valid = false;
    }
    if (!password) {
      passwordError.style.display = 'flex';
      valid = false;
    }
    if (!valid) return;

    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span class="spinner"></span> Verificando...';

    try {
      const formData = new FormData(form);
      const res = await fetch('/api/auth/login', {
        method: 'POST',
        body: formData,
      });

      if (res.redirected) {
        window.location.href = res.url;
        return;
      }

      const data = await res.json();
      if (res.ok && data.success) {
        submitBtn.innerHTML = '<i class="fa-solid fa-check"></i> ¡Bienvenido!';
        window.location.href = data.redirect || '/dashboard';
      } else {
        formError.style.display = 'flex';
        formError.innerHTML = `<i class="fa-solid fa-triangle-exclamation"></i> ${data.error || 'Credenciales incorrectas'}`;
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<i class="fa-solid fa-arrow-right-to-bracket"></i> Ingresar a mi cuenta';
      }
    } catch {
      formError.style.display = 'flex';
      formError.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i> Error de conexión. Intentá de nuevo.';
      submitBtn.disabled = false;
      submitBtn.innerHTML = '<i class="fa-solid fa-arrow-right-to-bracket"></i> Ingresar a mi cuenta';
    }
  });

  // Sync theme icon
  const themeIcon = document.getElementById('theme-icon');
  if (themeIcon) {
    const theme = document.documentElement.getAttribute('data-theme');
    themeIcon.className = theme === 'dark' ? 'fa-solid fa-sun' : 'fa-solid fa-moon';
  }
</script>
