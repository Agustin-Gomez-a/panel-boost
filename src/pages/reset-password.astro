---
import BaseLayout from '../layouts/BaseLayout.astro';

const token = Astro.url.searchParams.get('token') || '';
---

<BaseLayout
  title="Restablecer Contraseña — Pulse Panel Boost"
  description="Restablecé tu contraseña de Pulse Panel Boost."
  noIndex={true}
>
  <div style="min-height:100vh;display:flex;flex-direction:column;">
    <!-- Minimal navbar -->
    <header class="navbar">
      <div class="container">
        <div class="navbar__inner">
          <a href="/" class="navbar__logo" aria-label="Pulse Panel Boost - Inicio">
            <div class="navbar__logo-icon">
              <i class="fa-solid fa-bolt"></i>
            </div>
            <span class="navbar__logo-text">Pulse<span>Boost</span></span>
          </a>
          <div class="navbar__actions" style="margin-left:auto;">
            <button class="theme-toggle" onclick="toggleTheme()" aria-label="Cambiar tema" id="theme-toggle-rp">
              <i id="theme-icon" class="fa-solid fa-sun"></i>
            </button>
          </div>
        </div>
      </div>
    </header>

    <main style="flex:1;display:flex;align-items:center;justify-content:center;padding:2rem;" aria-labelledby="rp-title">
      <div style="width:100%;max-width:440px;">

        {!token && (
          <div class="card" style="text-align:center;padding:3rem;">
            <i class="fa-solid fa-triangle-exclamation" style="font-size:3rem;color:var(--danger);margin-bottom:1rem;display:block;"></i>
            <h1 style="font-size:1.5rem;margin-bottom:0.75rem;">Enlace inválido</h1>
            <p style="color:var(--text-secondary);margin-bottom:1.5rem;">Este enlace de recuperación no es válido o ya expiró.</p>
            <a href="/forgot-password" class="btn btn--primary" style="width:100%;justify-content:center;">
              <i class="fa-solid fa-rotate-right"></i>
              Solicitar nuevo enlace
            </a>
          </div>
        )}

        {token && (
          <div>
            <div id="success-state" style="display:none;text-align:center;" class="animate-fade-up">
              <div style="width:80px;height:80px;border-radius:var(--radius-xl);background:rgba(16,185,129,0.15);border:1px solid var(--success);display:flex;align-items:center;justify-content:center;font-size:2rem;margin:0 auto 1.5rem;color:var(--success);">
                <i class="fa-solid fa-circle-check"></i>
              </div>
              <h1 style="font-size:1.75rem;margin-bottom:0.75rem;">¡Contraseña restablecida!</h1>
              <p style="color:var(--text-secondary);font-size:0.95rem;line-height:1.7;margin-bottom:2rem;">
                Tu contraseña fue actualizada exitosamente. Ya podés iniciar sesión con tu nueva contraseña.
              </p>
              <a href="/login" class="btn btn--primary btn--lg" style="width:100%;justify-content:center;">
                <i class="fa-solid fa-arrow-right-to-bracket"></i>
                Iniciar Sesión
              </a>
            </div>

            <div id="form-state">
              <div style="text-align:center;margin-bottom:2rem;" class="animate-fade-up">
                <div style="width:64px;height:64px;border-radius:var(--radius-lg);background:linear-gradient(135deg,rgba(124,58,237,0.2),rgba(6,182,212,0.2));border:1px solid var(--accent);display:flex;align-items:center;justify-content:center;font-size:1.75rem;color:var(--accent-light);margin:0 auto 1.25rem;">
                  <i class="fa-solid fa-lock-open"></i>
                </div>
                <h1 id="rp-title" style="font-size:1.75rem;margin-bottom:0.5rem;">Nueva contraseña</h1>
                <p style="color:var(--text-secondary);font-size:0.9rem;">Elegí una contraseña segura para tu cuenta.</p>
              </div>

              <div class="card card--glow animate-fade-up animate-fade-up-delay-1">
                <form id="rp-form" novalidate>
                  <input type="hidden" name="token" id="rp-token" value={token} />

                  <div style="display:flex;flex-direction:column;gap:1.25rem;">
                    <div class="form-group">
                      <label class="form-label" for="rp-password">Nueva contraseña</label>
                      <div class="form-input-wrapper">
                        <i class="fa-solid fa-lock form-input-icon" aria-hidden="true"></i>
                        <input
                          class="form-input"
                          type="password"
                          id="rp-password"
                          name="password"
                          placeholder="Mínimo 8 caracteres"
                          autocomplete="new-password"
                          required
                          aria-required="true"
                          style="padding-right:3rem;"
                        />
                        <button type="button" id="toggle-pw" aria-label="Mostrar contraseña"
                          style="position:absolute;right:0.875rem;top:50%;transform:translateY(-50%);background:none;border:none;color:var(--text-muted);cursor:pointer;font-size:0.875rem;">
                          <i class="fa-solid fa-eye" id="pw-eye" aria-hidden="true"></i>
                        </button>
                      </div>
                      <div id="rp-strength" style="display:none;margin-top:0.5rem;">
                        <div style="display:flex;gap:4px;margin-bottom:0.25rem;">
                          <div id="sb1" style="height:3px;flex:1;border-radius:2px;background:var(--border);transition:background 0.3s;"></div>
                          <div id="sb2" style="height:3px;flex:1;border-radius:2px;background:var(--border);transition:background 0.3s;"></div>
                          <div id="sb3" style="height:3px;flex:1;border-radius:2px;background:var(--border);transition:background 0.3s;"></div>
                          <div id="sb4" style="height:3px;flex:1;border-radius:2px;background:var(--border);transition:background 0.3s;"></div>
                        </div>
                        <span id="sb-label" style="font-size:0.75rem;color:var(--text-muted);">Ingresá tu contraseña</span>
                      </div>
                      <span class="form-error" id="rp-pw-error" role="alert" style="display:none;">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        <span id="rp-pw-error-msg">Mínimo 8 caracteres, una mayúscula y un número</span>
                      </span>
                    </div>

                    <div class="form-group">
                      <label class="form-label" for="rp-confirm">Confirmar contraseña</label>
                      <div class="form-input-wrapper">
                        <i class="fa-solid fa-lock-open form-input-icon" aria-hidden="true"></i>
                        <input
                          class="form-input"
                          type="password"
                          id="rp-confirm"
                          name="confirmPassword"
                          placeholder="Repetí tu contraseña"
                          autocomplete="new-password"
                          required
                          aria-required="true"
                        />
                      </div>
                      <span class="form-error" id="rp-confirm-error" role="alert" style="display:none;">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        Las contraseñas no coinciden
                      </span>
                    </div>

                    <div id="rp-error" class="alert alert--error" style="display:none;" role="alert"></div>

                    <button type="submit" class="btn btn--primary" id="rp-submit" style="width:100%;justify-content:center;padding:0.875rem;">
                      <i class="fa-solid fa-floppy-disk"></i>
                      Guardar nueva contraseña
                    </button>
                  </div>
                </form>
              </div>
            </div>
          </div>
        )}

      </div>
    </main>
  </div>
</BaseLayout>

<script>
  // Toggle password visibility
  const toggleBtn = document.getElementById('toggle-pw');
  const pwInput = document.getElementById('rp-password') as HTMLInputElement;
  const pwEye = document.getElementById('pw-eye');

  toggleBtn?.addEventListener('click', () => {
    if (pwInput.type === 'password') {
      pwInput.type = 'text';
      if (pwEye) pwEye.className = 'fa-solid fa-eye-slash';
    } else {
      pwInput.type = 'password';
      if (pwEye) pwEye.className = 'fa-solid fa-eye';
    }
  });

  // Password strength
  const strengthEl = document.getElementById('rp-strength');
  const sbLabel = document.getElementById('sb-label');
  const bars = [
    document.getElementById('sb1'),
    document.getElementById('sb2'),
    document.getElementById('sb3'),
    document.getElementById('sb4'),
  ];

  pwInput?.addEventListener('input', () => {
    const val = pwInput.value;
    if (!strengthEl) return;
    if (val.length === 0) { strengthEl.style.display = 'none'; return; }
    strengthEl.style.display = 'block';

    let score = 0;
    if (val.length >= 8) score++;
    if (/[A-Z]/.test(val)) score++;
    if (/[0-9]/.test(val)) score++;
    if (/[^A-Za-z0-9]/.test(val)) score++;

    const colors = ['#ef4444', '#f59e0b', '#3b82f6', '#10b981'];
    const labels = ['Muy débil', 'Débil', 'Buena', 'Excelente'];

    bars.forEach((bar, i) => {
      if (bar) bar.style.background = i < score ? colors[score - 1] : 'var(--border)';
    });
    if (sbLabel) {
      sbLabel.textContent = labels[score - 1] || 'Muy débil';
      sbLabel.style.color = colors[score - 1] || 'var(--danger)';
    }
  });

  // Form submit
  const form = document.getElementById('rp-form') as HTMLFormElement;
  const submitBtn = document.getElementById('rp-submit') as HTMLButtonElement;
  const rpError = document.getElementById('rp-error') as HTMLElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const token = (document.getElementById('rp-token') as HTMLInputElement).value;
    const password = pwInput.value;
    const confirm = (document.getElementById('rp-confirm') as HTMLInputElement).value;

    const pwErr = document.getElementById('rp-pw-error') as HTMLElement;
    const confirmErr = document.getElementById('rp-confirm-error') as HTMLElement;
    const pwErrMsg = document.getElementById('rp-pw-error-msg') as HTMLElement;

    pwErr.style.display = 'none';
    confirmErr.style.display = 'none';
    rpError.style.display = 'none';

    let valid = true;

    if (password.length < 8) { pwErrMsg.textContent = 'Mínimo 8 caracteres'; pwErr.style.display = 'flex'; valid = false; }
    else if (!/[A-Z]/.test(password)) { pwErrMsg.textContent = 'Necesita al menos una letra mayúscula'; pwErr.style.display = 'flex'; valid = false; }
    else if (!/[0-9]/.test(password)) { pwErrMsg.textContent = 'Necesita al menos un número'; pwErr.style.display = 'flex'; valid = false; }

    if (password !== confirm) { confirmErr.style.display = 'flex'; valid = false; }
    if (!valid) return;

    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span class="spinner"></span> Guardando...';

    try {
      const formData = new FormData();
      formData.append('token', token);
      formData.append('password', password);
      formData.append('confirmPassword', confirm);

      const res = await fetch('/api/auth/reset-password', {
        method: 'POST',
        body: formData,
      });

      const data = await res.json();

      if (res.ok && data.success) {
        const formState = document.getElementById('form-state');
        const successState = document.getElementById('success-state');
        if (formState) formState.style.display = 'none';
        if (successState) successState.style.display = 'block';
      } else {
        rpError.style.display = 'flex';
        rpError.innerHTML = `<i class="fa-solid fa-triangle-exclamation"></i> ${data.error || 'Error al restablecer. Intentá de nuevo.'}`;
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<i class="fa-solid fa-floppy-disk"></i> Guardar nueva contraseña';
      }
    } catch {
      rpError.style.display = 'flex';
      rpError.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i> Error de conexión. Intentá de nuevo.';
      submitBtn.disabled = false;
      submitBtn.innerHTML = '<i class="fa-solid fa-floppy-disk"></i> Guardar nueva contraseña';
    }
  });

  // Sync theme icon
  const themeIcon = document.getElementById('theme-icon');
  if (themeIcon) {
    const theme = document.documentElement.getAttribute('data-theme');
    themeIcon.className = theme === 'dark' ? 'fa-solid fa-sun' : 'fa-solid fa-moon';
  }
</script>
